# Copy to .env or run scripts\configure-vision.ps1.
# .env is loaded by pass_bid_writing.config without overriding Hermes profile env vars.

PASS_BID_VISION_ENABLED="auto"
PASS_BID_VISION_PROVIDER="aliyun_qwen"
PASS_BID_VISION_MODEL="qwen3.7-plus-2026-05-26"
PASS_BID_VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY="replace-with-your-bailian-api-key"

# Evidence/reference production workbench model roles.
PASS_BID_TEXT_MODEL="deepseek-v4-pro"
PASS_BID_DEEPSEEK_THINKING="false"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY="replace-with-your-deepseek-api-key"
PASS_BID_BATCH_MODEL="qwen3.6-flash-2026-04-16"
PASS_BID_REVIEW_VISION_MODEL="glm-5v-turbo"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_API_KEY="replace-with-your-zhipu-api-key"

# Bounded concurrent section production. Raise carefully to avoid API throttling.
PASS_BID_TEXT_WORKERS="3"
PASS_BID_SECTION_MAX_TOKENS="3200"

# Optional alternatives:
# PASS_BID_VISION_PROVIDER="kimi"
# PASS_BID_VISION_MODEL="kimi-k2.6"
# PASS_BID_VISION_BASE_URL="https://api.moonshot.cn/v1"
# MOONSHOT_API_KEY="replace-with-your-moonshot-api-key"

# PASS_BID_VISION_PROVIDER="doubao"
# PASS_BID_VISION_MODEL="doubao-seed-1-6-vision"
# PASS_BID_VISION_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_API_KEY="replace-with-your-volcengine-ark-api-key"
