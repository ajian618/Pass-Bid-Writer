# 模型配置默认由工作台“模型配置”页面写入：
# %LOCALAPPDATA%\PassBidWriter\config\.env
# 本文件仅供开发和离线部署参考，切勿提交真实密钥。

PASS_BID_TEXT_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY=""
PASS_BID_DEEPSEEK_THINKING="false"

PASS_BID_VISION_MODEL="qwen3.7-plus-2026-05-26"
PASS_BID_BATCH_MODEL="qwen3.6-flash-2026-04-16"
PASS_BID_VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY=""

PASS_BID_REVIEW_VISION_MODEL="glm-5v-turbo"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_API_KEY=""

# 可选：覆盖默认数据目录。正式单机部署通常无需设置。
# PASS_BID_DATA_DIR="D:\PassBidWriterData"
